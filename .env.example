# ─── Which model drives the agent ────────────────────────────────────────────
# anthropic | groq | gemini | openai | ollama | custom
#
# Only the provider and its key are required — model, base URL and vision
# support all have per-provider defaults.

LLM_PROVIDER=groq

# ── Groq: free tier, no credit card. Good starting point for testing. ────────
#    Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Defaults to openai/gpt-oss-120b. GET /api/models lists what your key can use.
# LLM_MODEL=openai/gpt-oss-120b

# Tried once, automatically, if LLM_MODEL gets rate-limited during spec
# synthesis or repair (same provider and key, just a lighter/higher-quota model).
# LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# ── Gemini: also free, via Google's OpenAI-compatible endpoint. ──────────────
#    Its free tier is far roomier than Groq's on tokens-per-minute — the limit
#    that actually bites here, since the MCP tool schemas are resent every turn.
#    The trade is a per-day request cap instead of a per-minute token one.
#    Get a key at https://aistudio.google.com/apikey
#    Use the rolling -latest aliases. Google retires pinned ids for new keys
#    (gemini-2.5-flash among them), which surfaces as a 404 that reads like a
#    typo — GET /api/models lists what your own key can actually reach.
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=...                    # GOOGLE_API_KEY also accepted
# LLM_MODEL=gemini-flash-latest         # -lite is cheaper against the daily cap

# ── Anthropic: pay-as-you-go, billed separately from any Claude subscription.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-haiku-4-5        # much cheaper than the opus default

# ── Anything else OpenAI-compatible (local Ollama, OpenAI, Together, …)
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:14b
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://your-endpoint/v1
# LLM_API_KEY=...

# Override the preset's vision assumption if your model does support images.
# LLM_SUPPORTS_VISION=auto          # auto | true | false
# Retries on 429. Free tiers rate-limit hard, so this defaults high.
# LLM_MAX_RETRIES=4

# ─── Token budget ────────────────────────────────────────────────────────────
# The levers that decide whether a free tier survives a run.

# The provider's tokens-per-minute ceiling. Free tiers reject any single request
# larger than this with a 413, and the explore loop's history grows every turn —
# so when this is set, the oldest turns are dropped to keep each request under
# it. The agent always keeps its instructions and the test case; only the middle
# of its scrollback is shed, and the transcript that synthesis reads is built
# separately, so nothing is lost from the generated spec.
#
# Defaults to 8000 on groq (its free on-demand tier). Set 0 to disable, or raise
# it to whatever your provider's error message quotes after upgrading a key.
# LLM_TPM_LIMIT=8000

# Ceiling on one tool result before it reaches the model. A `get_elements` on a
# content-heavy page can return 20k+ characters — several thousand tokens, in a
# single turn. Defaults to 3000 when LLM_TPM_LIMIT is set, 20000 otherwise.
# MAX_TOOL_RESULT_CHARS=3000

# Device actions per lane before the agent is told to wrap up.
# 40 is comfortable on a paid key; use 12-20 on a free tier.
MAX_AGENT_STEPS=15

# Screenshots are always captured and shown in the UI. This controls whether
# they are also sent to the model — the single biggest input-token cost.
# auto = follow the model's vision support.
SEND_SCREENSHOTS_TO_MODEL=false

# Drop non-essential MCP tools, shrinking the schema block sent every turn.
# auto = on for every provider except Anthropic (which caches the prefix).
LEAN_TOOLS=auto

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8787
ARTIFACT_DIR=./artifacts

# ─── Local Appium (Android lane) ─────────────────────────────────────────────
# Start it yourself with `npm run appium` — the server preflights this URL and
# fails the Android lane with a clear message if it is unreachable.
APPIUM_URL=http://127.0.0.1:4723
ANDROID_DEVICE_NAME=emulator-5554

# ─── iOS lane (cloud only) ───────────────────────────────────────────────────
# iOS cannot run locally on Windows/Linux — XCUITest needs macOS + Xcode.
CLOUD_PROVIDER=none

# BROWSERSTACK_USERNAME=
# BROWSERSTACK_ACCESS_KEY=
# SAUCE_USERNAME=
# SAUCE_ACCESS_KEY=
# SAUCE_REGION=us-west-1

# ─── Verify phase ────────────────────────────────────────────────────────────
VERIFY_TIMEOUT_MS=300000
