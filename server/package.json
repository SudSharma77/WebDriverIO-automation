{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "index:framework": "tsx src/framework/cli.ts",
    "plan": "tsx src/planner/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@fastify/cors": "^11.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/yazl": "^3.3.1",
    "dotenv": "^17.2.1",
    "eslint": "^10.8.1",
    "eslint-plugin-wdio": "^9.31.1",
    "fastify": "^5.4.0",
    "openai": "^7.5.0",
    "typescript": "^5.9.3",
    "yazl": "^3.3.1",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "tsx": "^4.20.3"
  },
  "//": "WebdriverIO runner deps live here so generated specs under ./artifacts resolve them by walking up to ./node_modules. `typescript` is a runtime dependency: the framework indexer parses target projects with the TS compiler API.",
  "optionalDependencies": {
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "webdriverio": "^9.30.1"
  }
}
